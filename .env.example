# =============================================================================
#  Contrats RAG – IAP / Département Études & Projets
#  Fichier de configuration UNIQUE du déploiement.
#  Copier en ".env" (scripts/install.sh le fait et génère les secrets).
#  Aucune valeur de ce fichier ne doit pointer vers un service public.
# =============================================================================

# --- Version et images -------------------------------------------------------
APP_VERSION=0.1.0
# Version d'Open WebUI ÉPINGLÉE (ne jamais utiliser "main" ou "latest").
OWUI_VERSION=v0.13.4
POSTGRES_IMAGE=pgvector/pgvector:0.8.0-pg17
# Nom de l'instance Docker (préfixe des conteneurs et du réseau). À changer seulement
# pour faire tourner plusieurs instances sur le même serveur (ex. recette / production).
# COMPOSE_PROJECT_NAME=contrats-rag

# --- Réseau / exposition -----------------------------------------------------
OWUI_BIND=0.0.0.0
OWUI_PORT=3000
# Adresse par laquelle les utilisateurs accèdent à l'interface (ex. https://contrats.iap.local).
# En production, mettre la même valeur dans CORS_ALLOW_ORIGIN (au lieu de *).
WEBUI_URL=
CORS_ALLOW_ORIGIN=*
# Fuseau horaire des conteneurs
TZ=Africa/Algiers

# --- Stockage persistant (chemins sur le serveur hôte) -----------------------
# Tout l'état de l'application est sous DATA_ROOT : sauvegarder ce dossier
# + les dumps PostgreSQL (scripts/backup.sh) suffit pour migrer de serveur.
DATA_ROOT=./data
# Dossier de dépôt des documents à ingérer (un sous-dossier par contrat).
INBOX_DIR=./inbox

# --- Secrets (générés par scripts/install.sh) --------------------------------
POSTGRES_SUPERUSER_PASSWORD=change-me
OWUI_DB_PASSWORD=change-me
CONTRATS_INGEST_PASSWORD=change-me
CONTRATS_APP_PASSWORD=change-me
WEBUI_SECRET_KEY=change-me

# =============================================================================
#  API INTERNES DES MODÈLES (format compatible OpenAI)
#  - BASE_URL inclut le suffixe /v1 pour LLM, embeddings et vision.
#  - Laisser API_KEY vide si l'endpoint ne demande pas d'authentification.
#  - Voir docs/CONNEXION_MODELES.md pour vLLM, TEI, Infinity, Ollama, passerelle.
# =============================================================================

# --- LLM (chat) ---------------------------------------------------------------
LLM_BASE_URL=http://llm.interne.local:8000/v1
LLM_API_KEY=
LLM_MODEL=nom-du-modele-llm

# --- Embeddings -----------------------------------------------------------------
EMBEDDING_BASE_URL=http://embeddings.interne.local:8080/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
# Dimension des vecteurs produits par le modèle (bge-m3 = 1024).
# ATTENTION : à fixer AVANT la première indexation (Open WebUI et index métier).
EMBEDDING_DIM=1024
# Préfixes requis par certains modèles (ex. e5 : "query: " / "passage: ").
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=
# Modèles « Matryoshka » de grande dimension (Qwen3-Embedding-8B = 4096) : les index pgvector
# sont limités à 2000 dimensions. EMBEDDING_REQUEST_DIMENSIONS=true demande au serveur
# (Ollama, vLLM) un vecteur de taille EMBEDDING_DIM ; EMBEDDING_TRUNCATE=true tronque et
# renormalise côté client si le serveur ignore ce paramètre.
EMBEDDING_REQUEST_DIMENSIONS=false
EMBEDDING_TRUNCATE=false

# --- Reranker -------------------------------------------------------------------
# RERANKER_API : cohere (format /rerank de vLLM, Infinity, Jina, Cohere)
#                tei    (Text Embeddings Inference de Hugging Face)
#                none   (pas de reranking)
RERANKER_API=cohere
RERANKER_BASE_URL=http://reranker.interne.local:8080/v1
RERANKER_API_KEY=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- OCR ----------------------------------------------------------------------
# OCR_ENGINE : tesseract (local, inclus dans l'image d'ingestion)
#              vision    (modèle vision interne, compatible OpenAI)
#              none
OCR_ENGINE=tesseract
OCR_LANGUAGES=fra+eng
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
# Côté maximal (pixels) des pages envoyées au modèle Vision (limite les jetons image).
VISION_MAX_SIDE=1800

# --- Passerelle d'extraction pour Open WebUI (PDF scannés / images déposés dans le chat) ---
# Activer avec COMPOSE_PROFILES=ocr : démarre le service « ocr-bridge » (même image que
# l'ingestion, aucun port publié) et branche Open WebUI dessus (moteur « external »).
# La clé est générée par install.sh. Voir DEPLOIEMENT_ROCKY_OLLAMA.md §4.
# COMPOSE_PROFILES=ocr
OCR_BRIDGE_API_KEY=change-me

# --- Sécurité réseau des appels modèles --------------------------------------
# Liste blanche des hôtes autorisés pour les appels IA (séparés par des virgules,
# ".domaine" autorise tous les sous-domaines). Vide = pas de contrôle applicatif.
AI_ALLOWED_HOSTS=.interne.local
# Vérification TLS des endpoints internes (placer les CA internes dans ./certs).
AI_VERIFY_TLS=true

# --- Paramètres métier ----------------------------------------------------------
# Politique d'accès par défaut aux contrats si aucune règle n'existe : none | all
# (pour le POC "all" ; en production définir les règles avec "contract-rag access").
DEFAULT_CONTRACT_ACCESS=all
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=200
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40

# --- Open WebUI : RAG natif ----------------------------------------------------
# Reranking du RAG natif d'Open WebUI (optionnel, valeurs à valider sur la
# version épinglée — voir docs/POINTS_A_VERIFIER.md).
OWUI_RERANKING_ENGINE=
OWUI_EXTERNAL_RERANKER_URL=
OWUI_RERANKING_MODEL=
# Moteur d'extraction des fichiers déposés dans le chat : vide = lecteur interne d'Open WebUI
# (PDF texte uniquement) ; "external" = passerelle ocr-bridge (OCR des scans).
# NB : valeur prise en compte au 1er démarrage ; ensuite, Admin > Paramètres > Documents.
OWUI_CONTENT_EXTRACTION_ENGINE=
OWUI_EXTERNAL_LOADER_URL=http://ocr-bridge:8090
# true = les fichiers déposés dans le chat sont passés en entier au LLM, sans vectorisation.
# OBLIGATOIRE si le modèle d'embeddings dépasse 2000 dimensions (ex. Qwen3-Embedding-8B) :
# Open WebUI ne sait pas demander une dimension réduite.
OWUI_BYPASS_EMBEDDING=false
# Inscription : laisser true pour créer le 1er compte (admin), puis passer à false.
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=pending
